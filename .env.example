# Copy to .env (never committed). slurm/job.sh sources it inside the allocation.
LITELLM_MASTER_KEY=replace-with-a-local-secret
HF_TOKEN=
# Optional overrides read by the profiles and the launcher:
# EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B      # heavy-lite-embed.yaml's embedding model
# GLINER_PORT=8091                              # when another user's server holds 8090
# LLM_SETUP_VLLM_HELP_TIMEOUT_SECONDS=600
# VLLM_USE_FLASHINFER_SAMPLER=1                 # only with a CUDA toolkit (nvcc) installed

# Python, vLLM and uv's caches on node-local scratch, not the shared home filesystem.
# Model weights stay in the cluster's Hugging Face cache; do not set HF_* cache variables here.
LLM_SETUP_LOCAL_ROOT="${SLURM_TMPDIR:-${TMPDIR:-/tmp}}/${USER}/llm-setup"
UV_PROJECT_ENVIRONMENT="${LLM_SETUP_LOCAL_ROOT}/venv"
UV_CACHE_DIR="${LLM_SETUP_LOCAL_ROOT}/uv-cache"
UV_PYTHON_INSTALL_DIR="${LLM_SETUP_LOCAL_ROOT}/python"
UV_PYTHON_CACHE_DIR="${LLM_SETUP_LOCAL_ROOT}/python-cache"
