EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
HF_TOKEN=
LITELLM_MASTER_KEY=replace-with-a-local-secret
LLM_SETUP_VLLM_HELP_TIMEOUT_SECONDS=600

# Keep Python, vLLM, and uv's caches on node-local scratch instead of a shared home filesystem.
LLM_SETUP_LOCAL_ROOT="${SLURM_TMPDIR:-${TMPDIR:-/tmp}}/${USER}/llm-setup"
UV_PROJECT_ENVIRONMENT="${LLM_SETUP_LOCAL_ROOT}/venv"
UV_CACHE_DIR="${LLM_SETUP_LOCAL_ROOT}/uv-cache"
UV_PYTHON_INSTALL_DIR="${LLM_SETUP_LOCAL_ROOT}/python"
UV_PYTHON_CACHE_DIR="${LLM_SETUP_LOCAL_ROOT}/python-cache"
